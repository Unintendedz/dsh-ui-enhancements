{
  "name": "dsh-ui-enhancements",
  "version": "0.5.0",
  "description": "Small, focused UI enhancements for DeepSeek Harness",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ui-enhancements",
    "session-management"
  ],
  "author": "Unintended",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unintendedz/dsh-ui-enhancements.git"
  },
  "homepage": "https://github.com/Unintendedz/dsh-ui-enhancements#readme",
  "bugs": {
    "url": "https://github.com/Unintendedz/dsh-ui-enhancements/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "sideEffects": [
    "./lib/client.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
